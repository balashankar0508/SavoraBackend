NODE_ENV=development
PORT=4000

# postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgres://savora_app:CHANGE_ME@localhost:5432/savora

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_PEPPER=

# Gemini API key for AI receipt parsing (server-side only, never shipped to the client)
GEMINI_API_KEY=

# Optional: Claude Haiku 4.5 fallback for receipt parsing when Gemini is
# overloaded (503s). Get a key at https://console.anthropic.com -- leave
# blank to skip the fallback (Gemini failures just surface as before).
# ~₹2 per 1,000 scans when it's actually used.
ANTHROPIC_API_KEY=

# Transactional email (Brevo) for OTP + password-reset emails
# Free tier: 300 emails/day, no credit card required — https://app.brevo.com
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM="Spenxo <noreply@yourdomain.com>"

# Mobile app has no browser origin; keep permissive but explicit
CORS_ORIGIN=*

# ── Events v2 ──────────────────────────────────────────────
# Private upload directory (outside web root + repo). Production: /var/lib/spenxo/uploads
UPLOAD_DIR=./uploads
# Generate each with: openssl rand -hex 32  (do NOT reuse the JWT secrets)
CHAT_ENCRYPTION_KEY=
INVITE_CODE_KEY=
# Push notifications (Firebase Cloud Messaging). Path to the service-account JSON, kept outside the repo
# and chmod 600. Leave blank to run without push.
FIREBASE_SERVICE_ACCOUNT_PATH=
