{
  "_note": "Shared with the mobile app's split preview. Each case: amount in paise, mode, inputs, and either expect (share_paise per input, in input order) or expectError. Tie-break: larger remainder first, then smaller user_id.",
  "cases": [
    { "name": "equal 100.01 over 3 (tie broken by user_id)", "amount": 10001, "mode": "equal",
      "inputs": [{"user_id":"u1","value":0},{"user_id":"u2","value":0},{"user_id":"u3","value":0}],
      "expect": [3334, 3334, 3333] },
    { "name": "equal 1.00 over 3", "amount": 100, "mode": "equal",
      "inputs": [{"user_id":"u1","value":0},{"user_id":"u2","value":0},{"user_id":"u3","value":0}],
      "expect": [34, 33, 33] },
    { "name": "equal 1 paisa over 3", "amount": 1, "mode": "equal",
      "inputs": [{"user_id":"u1","value":0},{"user_id":"u2","value":0},{"user_id":"u3","value":0}],
      "expect": [1, 0, 0] },
    { "name": "equal even", "amount": 5000, "mode": "equal",
      "inputs": [{"user_id":"u1","value":0},{"user_id":"u2","value":0}],
      "expect": [2500, 2500] },
    { "name": "equal ignores input order for ties", "amount": 100, "mode": "equal",
      "inputs": [{"user_id":"u3","value":0},{"user_id":"u1","value":0},{"user_id":"u2","value":0}],
      "expect": [33, 34, 33] },
    { "name": "equal max amount over 3", "amount": 1000000000, "mode": "equal",
      "inputs": [{"user_id":"u1","value":0},{"user_id":"u2","value":0},{"user_id":"u3","value":0}],
      "expect": [333333334, 333333333, 333333333] },
    { "name": "percentage exact thirds", "amount": 10000, "mode": "percentage",
      "inputs": [{"user_id":"u1","value":3333},{"user_id":"u2","value":3333},{"user_id":"u3","value":3334}],
      "expect": [3333, 3333, 3334] },
    { "name": "percentage 50/50 odd amount", "amount": 1001, "mode": "percentage",
      "inputs": [{"user_id":"u1","value":5000},{"user_id":"u2","value":5000}],
      "expect": [501, 500] },
    { "name": "percentage 70/30 remainder goes to larger fractional part", "amount": 999, "mode": "percentage",
      "inputs": [{"user_id":"u1","value":7000},{"user_id":"u2","value":3000}],
      "expect": [699, 300] },
    { "name": "shares 1:2:3", "amount": 100, "mode": "shares",
      "inputs": [{"user_id":"u1","value":1},{"user_id":"u2","value":2},{"user_id":"u3","value":3}],
      "expect": [17, 33, 50] },
    { "name": "exact", "amount": 1000, "mode": "exact",
      "inputs": [{"user_id":"u1","value":600},{"user_id":"u2","value":400}],
      "expect": [600, 400] },
    { "name": "exact allows a zero share", "amount": 500, "mode": "exact",
      "inputs": [{"user_id":"u1","value":500},{"user_id":"u2","value":0}],
      "expect": [500, 0] },
    { "name": "exact total mismatch", "amount": 1000, "mode": "exact",
      "inputs": [{"user_id":"u1","value":600},{"user_id":"u2","value":300}],
      "expectError": "splits_must_match_amount" },
    { "name": "exact negative share", "amount": 1000, "mode": "exact",
      "inputs": [{"user_id":"u1","value":1100},{"user_id":"u2","value":-100}],
      "expectError": "splits_must_match_amount" },
    { "name": "percentage not 100", "amount": 1000, "mode": "percentage",
      "inputs": [{"user_id":"u1","value":5000},{"user_id":"u2","value":4999}],
      "expectError": "percentages_must_total_100" },
    { "name": "percentage fractional basis points", "amount": 1000, "mode": "percentage",
      "inputs": [{"user_id":"u1","value":5000.5},{"user_id":"u2","value":4999.5}],
      "expectError": "percentages_must_total_100" },
    { "name": "shares with zero weight", "amount": 1000, "mode": "shares",
      "inputs": [{"user_id":"u1","value":0},{"user_id":"u2","value":2}],
      "expectError": "shares_must_be_positive_integers" },
    { "name": "duplicate member", "amount": 1000, "mode": "equal",
      "inputs": [{"user_id":"u1","value":0},{"user_id":"u1","value":0}],
      "expectError": "invalid_split_members" },
    { "name": "no members", "amount": 1000, "mode": "equal", "inputs": [],
      "expectError": "invalid_split_members" },
    { "name": "zero amount", "amount": 0, "mode": "equal",
      "inputs": [{"user_id":"u1","value":0}],
      "expectError": "invalid_amount" },
    { "name": "amount over limit", "amount": 1000000001, "mode": "equal",
      "inputs": [{"user_id":"u1","value":0}],
      "expectError": "invalid_amount" }
  ]
}
